<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: HTTPS only, system certificate authorities only (no
     user-installed CAs), never plain HTTP. The only server is the parent-
     account API, used only after a parent chooses an account. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
