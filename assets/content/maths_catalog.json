  "parentRules": [
    {
      "en": "Keep sessions short: two or three sittings of fifteen minutes.",
      "ar": "خلي الجلسة قصيرة: حوالي ربع ساعة في كل مرة.",
      "sourcePage": 2
    },
    {
      "en": "Play with objects before answering on screen.",
      "ar": "خلّي الطفل يلعب بالحاجات الأول، وبعدها يجاوب.",
      "sourcePage": 2
    },
    {
      "en": "Ask for a guess before counting. Praise the thinking.",
      "ar": "اسأله يتوقع العدد قبل العدّ، وامدح طريقته في التفكير.",
      "sourcePage": 2
    },
    {
      "en": "An adult supervises. Keep small objects away from younger children. An adult handles scissors. Use water at the sink, away from electrical items.",
      "ar": "لازم شخص كبير يكون موجود. خلّي الحاجات الصغيرة بعيد عن الأطفال الأصغر، والكبير يمسك المقص. أنشطة المية تكون عند الحوض وبعيد عن الكهرباء.",
      "sourcePage": 2
    }
  ]
