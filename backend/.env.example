# Example settings for local development. Copy to .env and fill in.
# Real secrets are never committed (generate them with scripts/generate-env.mjs).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# From `node scripts/local-postgres.mjs` (prints the URL) or docker-compose.dev.yml
DATABASE_URL=postgresql://science:CHANGE_ME@127.0.0.1:54320/science_adventure
# Base64 of an Ed25519 private key in PKCS#8 PEM (scripts/generate-env.mjs makes one)
JWT_PRIVATE_KEY=
JWT_KEY_ID=dev
PUBLIC_WEB_URL=http://localhost:8080
# Mailpit from infrastructure/docker-compose.dev.yml shows every email at http://localhost:8025
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=My School Adventures <dev@localhost>
CONSENT_VERSION=dev-1
COOKIE_SECURE=false
BREACHED_PASSWORD_CHECK=false
