{
  "name": "science-adventure-api",
  "version": "0.1.0",
  "private": true,
  "description": "Parent accounts and progress sync for Science Adventure",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" --ignore-path .gitignore",
    "test": "jest",
    "test:e2e": "jest -c test/jest-e2e.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "openapi:lint": "redocly lint ../api/openapi.yaml --config ../api/redocly.yaml"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.0.14",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.7",
    "@redocly/cli": "2.57.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true
  }
}
